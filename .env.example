DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reporeplay"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_INSTALLATION_ID=""
ADMIN_HEALTH_TOKEN=""
# Optional dedicated key; otherwise derived from the GitHub App private key.
PREFLIGHT_SIGNING_SECRET=""
PREFLIGHT_TOKEN_TTL_SECONDS="900"
IDEMPOTENCY_RETENTION_SECONDS="86400"
MAX_IMPORTS_PER_IP_WINDOW="20"
IMPORT_IP_WINDOW_SECONDS="900"
# Set only behind a proxy that overwrites this header with one verified client IP.
# Empty uses a shared quota and ignores client-supplied forwarding headers.
TRUSTED_CLIENT_IP_HEADER=""
MAX_GLOBAL_RUNNING_JOBS="4"
MAX_GLOBAL_PENDING_RUNS="20"
MAX_FIRST_PARENT_COMMITS="500"
MAX_HEAD_FILES="25000"
JOB_LEASE_SECONDS="60"
JOB_HEARTBEAT_SECONDS="15"
WORKER_POLL_INTERVAL_MS="1000"
WORKER_CONCURRENCY="2"
WORKER_ID=""
WORKER_SWEEP_INTERVAL_MS="5000"
WORKER_GRACEFUL_SHUTDOWN_MS="30000"
JOB_RETRY_BASE_SECONDS="5"
JOB_RETRY_MAX_SECONDS="3600"
JOB_RETRY_JITTER_PERCENT="20"
QUEUE_LAG_WARN_SECONDS="60"
